# The API bootstrap reads environment/mode/port; only local/test are supported.
LMPS_ENVIRONMENT=local
LMPS_EXECUTION_MODE=test
LMPS_API_PORT=18501
# Python entrypoint reads exported environment variables; it does not auto-load .env.
LMPS_ML_PORT=18502
# MariaDB is reserved; no source connector reads it.
LMPS_MARIADB_DSN=
# Optional local app-role DSN; prefer start:api:db to load ignored generated credentials.
LMPS_POSTGRES_DSN=
# Optional separate lmps_reviewer credential, same local database instance; requires configured local JWT auth.
# Generated credentials stay in ignored .local/postgres/reviewer.env; do not copy them into source.
LMPS_LOCAL_REVIEW_DSN=

# Optional isolated policy-governance writer; same database and local JWT auth are required.
# Generated by separately authorized db:prepare-policy into ignored .local/postgres/policy.env.
LMPS_LOCAL_POLICY_DSN=

# Optional isolated case writer, same local DB and configured local JWT auth.
# Generated credentials remain in ignored .local/postgres/case.env.
LMPS_LOCAL_CASE_DSN=
