{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmps:contracts:0.1.0-draft.1:alert",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft.1",
      "title": "Schema Version",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "live",
        "shadow",
        "backfill",
        "replay",
        "test"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Correlation Id",
      "type": "string"
    },
    "alert_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Alert Id",
      "type": "string"
    },
    "assessment_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Assessment Id",
      "type": "string"
    },
    "transaction_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Transaction Id",
      "type": "string"
    },
    "transaction_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Transaction Revision",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
      "title": "Created At",
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "risk_dimensions": {
      "items": {
        "enum": [
          "fraud",
          "mule_network",
          "aml"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Risk Dimensions",
      "type": "array",
      "uniqueItems": true
    },
    "reason_codes": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "alert_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Alert Policy Version",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "execution_mode",
    "run_id",
    "correlation_id",
    "alert_id",
    "assessment_id",
    "transaction_id",
    "transaction_revision",
    "created_at",
    "severity",
    "risk_dimensions",
    "reason_codes",
    "alert_policy_version",
    "evidence_refs"
  ],
  "title": "Alert",
  "type": "object"
}
