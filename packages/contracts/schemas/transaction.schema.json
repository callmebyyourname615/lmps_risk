{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmps:contracts:0.1.0-draft.1:transaction",
  "$defs": {
    "ResolvedAccount": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "resolved",
          "title": "Status",
          "type": "string"
        },
        "namespace": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Namespace",
          "type": "string"
        },
        "owning_institution_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Owning Institution Id",
          "type": "string"
        },
        "account_token": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Account Token",
          "type": "string"
        },
        "resolution_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Resolution Version",
          "type": "string"
        }
      },
      "required": [
        "status",
        "namespace",
        "owning_institution_id",
        "account_token",
        "resolution_version"
      ],
      "title": "ResolvedAccount",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Namespace",
          "type": "string"
        },
        "record_ref": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Ref",
          "type": "string"
        },
        "mapping_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mapping Version"
        }
      },
      "required": [
        "namespace",
        "record_ref",
        "mapping_version"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "UnresolvedAccount": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unresolved",
          "title": "Status",
          "type": "string"
        },
        "source_representation": {
          "enum": [
            "masked",
            "unmasked",
            "unknown"
          ],
          "title": "Source Representation",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "status",
        "source_representation",
        "reason_code"
      ],
      "title": "UnresolvedAccount",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft.1",
      "title": "Schema Version",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "live",
        "shadow",
        "backfill",
        "replay",
        "test"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Correlation Id",
      "type": "string"
    },
    "transaction_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Transaction Id",
      "type": "string"
    },
    "transaction_revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Transaction Revision",
      "type": "string"
    },
    "source_reference": {
      "$ref": "#/$defs/SourceReference"
    },
    "occurred_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Occurred At"
    },
    "observed_at": {
      "format": "date-time",
      "pattern": "^[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$",
      "title": "Observed At",
      "type": "string"
    },
    "sender": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnresolvedAccount"
        },
        {
          "$ref": "#/$defs/ResolvedAccount"
        }
      ],
      "title": "Sender"
    },
    "receiver": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnresolvedAccount"
        },
        {
          "$ref": "#/$defs/ResolvedAccount"
        }
      ],
      "title": "Receiver"
    },
    "source_bank_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Bank Id"
    },
    "destination_bank_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Destination Bank Id"
    },
    "amount": {
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "title": "Amount",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "transaction_type": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Transaction Type"
    },
    "channel": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Channel"
    },
    "transaction_status": {
      "enum": [
        "unknown",
        "pending",
        "succeeded",
        "failed",
        "reversed",
        "partially_reversed"
      ],
      "title": "Transaction Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "execution_mode",
    "run_id",
    "correlation_id",
    "transaction_id",
    "transaction_revision",
    "source_reference",
    "occurred_at",
    "observed_at",
    "sender",
    "receiver",
    "source_bank_id",
    "destination_bank_id",
    "amount",
    "currency",
    "transaction_type",
    "channel",
    "transaction_status"
  ],
  "title": "Transaction",
  "type": "object"
}
