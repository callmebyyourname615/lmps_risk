{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FeatureSnapshot": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision Sha256"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "feature_version": {
          "const": "lmps-features-1",
          "title": "Feature Version",
          "type": "string"
        },
        "feature_spec_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Spec Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "minItems": 6,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Values"
        },
        "net_amount_cents": {
          "anyOf": [
            {
              "pattern": "^[0-9]{1,24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Net Amount Cents"
        },
        "feature_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Sha256",
          "type": "string"
        }
      },
      "required": [
        "target",
        "revision_sha256",
        "as_of",
        "currency",
        "feature_version",
        "feature_spec_sha256",
        "status",
        "reason_code",
        "values",
        "net_amount_cents",
        "feature_sha256"
      ],
      "title": "FeatureSnapshot",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "pattern": "^synthetic_[a-z0-9_]{1,40}$",
          "title": "Namespace",
          "type": "string"
        },
        "transaction_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Transaction Id",
          "type": "string"
        },
        "revision_number": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        }
      },
      "required": [
        "namespace",
        "transaction_id",
        "revision_number"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1,
      "title": "Format",
      "type": "integer"
    },
    "execution_mode": {
      "const": "shadow",
      "title": "Execution Mode",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "local_synthetic",
        "user_supplied_file"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "source_semantics": {
      "enum": [
        "synthetic_declared",
        "unverified"
      ],
      "title": "Source Semantics",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/FeatureSnapshot"
    }
  },
  "required": [
    "format",
    "execution_mode",
    "provenance",
    "source_semantics",
    "snapshot"
  ],
  "title": "ShadowRequest",
  "type": "object"
}
