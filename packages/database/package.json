{
  "name": "@lmps/database",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @lmps/risk build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @lmps/risk build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test --test-concurrency=2 test/*.test.mjs"
  },
  "dependencies": {
    "@lmps/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "@lmps/risk": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
